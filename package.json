{
  "name": "juel",
  "version": "1.0.0",
  "description": "User Interface web components",
  "targets": {
    "default": {
      "distDir": "./dist",
      "context": "browser"
    }
  },
  "browserslist": [
    "Chrome > 50"
  ],
  "scripts": {
    "dev": "parcel build juel.ts --no-optimize --no-scope-hoist && npx copyfiles dist/*.* examples -f",
    "build": "del .parcel-cache && parcel build juel.ts",
    "debug": "node --inspect-brk ./node_modules/parcel/lib/cli.js build juel.ts",
    "serve": "npm run dev && live-server --open=examples",
    "examples": "parcel build examples/_TS/example.ts --no-optimize --no-scope-hoist --no-cache && npx copyfiles dist/example.js* examples -f",
    "test": "jest",
    "test:browser:build": "parcel build tests/browser/files-contract.ts --no-optimize --no-scope-hoist --no-cache",
    "test:browser": "npm run test:browser:build && playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jollify-Software/juel.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Jollify-Software/juelissues"
  },
  "homepage": "https://github.com/Jollify-Software/juel#readme",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@floating-ui/dom": "^1.6.12",
    "@interactjs/interactjs": "^1.10.28",
    "@lezer/common": "^1.5.3",
    "@lezer/lr": "^1.4.11",
    "@popperjs/core": "^2.11.8",
    "@swc/helpers": "^0.5.15",
    "@types/toastr": "^2.1.43",
    "@zxing/browser": "^0.1.5",
    "animejs": "^3.2.2",
    "bind-decorator": "^1.0.11",
    "codemirror": "^6.0.1",
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.7",
    "date-fns": "^4.1.0",
    "hammerjs": "^2.0.8",
    "highlight.js": "^11.10.0",
    "jquery": "^3.7.1",
    "leaflet": "^1.9.4",
    "lit": "^3.2.1",
    "lodash": "^4.18.1",
    "qrcode-generator": "^2.0.4",
    "quill": "^2.0.3",
    "rxjs": "^7.8.1",
    "tippy.js": "^6.3.7",
    "vanilla-tilt": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@parcel/optimizer-data-url": "^2.16.4",
    "@parcel/transformer-inline-string": "^2.16.4",
    "@parcel/transformer-less": "^2.16.4",
    "@parcel/transformer-typescript-tsc": "^2.16.4",
    "@playwright/test": "^1.64.0",
    "@svgdotjs/svg.js": "^3.2.4",
    "@types/bingmaps": "7.0.25",
    "@types/chart.js": "^2.9.41",
    "@types/eslint__js": "^8.42.3",
    "@types/google.maps": "^3.58.1",
    "@types/hammerjs": "^2.0.46",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^3.5.32",
    "@types/leaflet": "^1.9.14",
    "autoprefixer": "^10.4.20",
    "copyfiles": "^2.4.1",
    "eslint": "^9.15.0",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "less": "^4.2.0",
    "lucide-static": "^1.59.0",
    "madge": "^8.0.0",
    "parcel": "^2.16.4",
    "postcss": "^8.5.30",
    "process": "^0.11.10",
    "serve": "^14.2.6",
    "svgo": "^3.3.5",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  },
  "overrides": {
    "brace-expansion@^1": "1.1.21",
    "compression": "^1.8.2",
    "deepmerge-ts": "^8.0.2"
  }
}
